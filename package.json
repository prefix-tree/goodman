{
  "name": "shadcn-dashboard",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev & pnpm --filter api dev & pnpm --filter api dev:agent & wait",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:agent": "pnpm --filter api dev:agent",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "start": "pnpm --filter api start & pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
