{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:agent": "tsx watch src/agent/index.ts dev",
    "build": "tsup src/index.ts src/agent/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "start:agent": "node dist/agent/index.js start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed/demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@livekit/agents": "^1.3.2",
    "@livekit/agents-plugin-openai": "^1.3.2",
    "@livekit/agents-plugin-silero": "^1.3.2",
    "hono": "^4.7.11",
    "livekit-server-sdk": "^2.15.2",
    "mongodb": "^7.2.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
